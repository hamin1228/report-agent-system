# Required for the default model. You can use any model supported by LiteLLM.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model aliases passed to LiteLLM
REPORT_AGENT_MODEL=openai/gpt-4.1-mini
REPORT_AGENT_EVALUATOR_MODEL=openai/gpt-4.1-mini

# Runtime controls
REPORT_AGENT_MAX_AGENT_ITERATIONS=8
REPORT_AGENT_MAX_EVALUATION_RETRIES=2
REPORT_AGENT_MAX_PARALLEL_SEARCHES=4
REPORT_AGENT_MAX_QUERIES_PER_SECTION=3
REPORT_AGENT_MAX_SOURCES_PER_SECTION=8
REPORT_AGENT_MINIMUM_SOURCE_SCORE=0.45
REPORT_AGENT_REQUEST_TIMEOUT_SECONDS=30
REPORT_AGENT_MAX_API_RETRIES=3
REPORT_AGENT_RETRY_BASE_DELAY_SECONDS=1.0
REPORT_AGENT_MAX_FETCH_BYTES=1000000
REPORT_AGENT_MAX_FETCH_REDIRECTS=3
REPORT_AGENT_WORKSPACE=workspace

# Optional web search provider (Tavily)
TAVILY_API_KEY=
